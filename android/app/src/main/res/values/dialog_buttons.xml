<resources>
  <style name="ChatDialogButton" parent="android:style/Widget.Material.Button.Borderless">
    <item name="android:textAllCaps">false</item>
    <item name="android:textColor">@color/chat_dialog_ink</item>
    <item name="android:textSize">16sp</item>
    <item name="android:minHeight">48dp</item>
    <item name="android:minWidth">92dp</item>
    <item name="android:paddingLeft">20dp</item>
    <item name="android:paddingRight">20dp</item>
  </style>
  <style name="ChatDialogPositiveButton" parent="ChatDialogButton">
    <item name="android:background">@drawable/chat_dialog_positive</item>
  </style>
  <style name="ChatDialogNegativeButton" parent="ChatDialogButton">
    <item name="android:background">@drawable/chat_dialog_negative</item>
  </style>
</resources>

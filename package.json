{
  "name": "cloudflare-anon-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/integration.test.mjs tests/sfu-contract.test.mjs",
    "check": "pnpm typecheck && pnpm test && node --check public/app.js && node --check public/call.js && wrangler deploy --dry-run --outdir .build",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply chat --local",
    "db:remote": "wrangler d1 migrations apply chat --remote",
    "test:remote": "node --test tests/remote.test.mjs"
  },
  "dependencies": {
    "aws4fetch": "1.0.20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261027.1",
    "typescript": "5.9.3",
    "wrangler": "4.153.0",
    "playwright": "1.56.1"
  },
  "packageManager": "pnpm@10.32.1"
}
